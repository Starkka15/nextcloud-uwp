<Page x:Class="NextcloudUWP.Views.LockPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#0082c9">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24">
            <TextBlock Text="Nextcloud" FontSize="32" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center" />
            <TextBlock x:Name="StatusText"
                       Text="Verifying identity…"
                       FontSize="15" Foreground="#ccffffff"
                       HorizontalAlignment="Center" />
            <ProgressRing x:Name="LockRing" IsActive="True"
                          Width="48" Height="48" Foreground="White"
                          HorizontalAlignment="Center" />
            <Button x:Name="RetryButton" Content="Try again"
                    HorizontalAlignment="Center"
                    Background="White" Foreground="#0082c9"
                    Visibility="Collapsed"
                    Click="RetryButton_Click" />
        </StackPanel>
    </Grid>
</Page>
