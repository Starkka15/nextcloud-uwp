<Page x:Class="NextcloudUWP.Views.CommentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Background="#0082c9" Padding="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Click="BackButton_Click"
                    Foreground="White" Background="Transparent">
                <SymbolIcon Symbol="Back" />
            </Button>
            <TextBlock x:Name="TitleText" Grid.Column="1"
                       Foreground="White" VerticalAlignment="Center"
                       FontSize="16" Margin="8,0,0,0"
                       TextTrimming="CharacterEllipsis" />
        </Grid>

        <!-- Comment list -->
        <Grid Grid.Row="1">
            <ProgressRing x:Name="LoadingRing"
                          IsActive="True" Width="60" Height="60"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />

            <ListView x:Name="CommentsList" SelectionMode="None"
                      Padding="12" Visibility="Collapsed">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ActorDisplayName}"
                                           FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding TimeText}"
                                           Foreground="#757575" FontSize="12" />
                            </Grid>
                            <TextBlock Text="{Binding Message}"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:Name="EmptyText" Text="No comments yet."
                       Foreground="#757575" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed" />
        </Grid>

        <!-- Post comment -->
        <Grid Grid.Row="2" Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
              Padding="12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="CommentBox" Grid.Column="0"
                     PlaceholderText="Write a comment…"
                     TextWrapping="Wrap" MaxHeight="80"
                     AcceptsReturn="False" />
            <Button Grid.Column="1" Content="Post"
                    Click="PostComment_Click"
                    Background="#0082c9" Foreground="White"
                    Margin="8,0,0,0" VerticalAlignment="Bottom" />
        </Grid>
    </Grid>
</Page>
