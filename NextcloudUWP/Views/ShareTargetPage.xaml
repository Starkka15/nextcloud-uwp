<Page x:Class="NextcloudUWP.Views.ShareTargetPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#0082c9" Padding="12,0">
            <TextBlock Text="Upload to Nextcloud"
                       Foreground="White" VerticalAlignment="Center"
                       FontSize="18" Margin="12,0,0,0" />
        </Grid>

        <StackPanel Grid.Row="1" Padding="16" Spacing="12">
            <TextBlock x:Name="SharedFilesText" FontSize="14" TextWrapping="Wrap" />

            <TextBlock Text="Upload to folder:" FontSize="13" Foreground="#757575" />
            <TextBox x:Name="DestFolderBox"
                     PlaceholderText="/Photos"
                     Text="/Photos" />

            <Button x:Name="UploadButton" Content="Upload"
                    HorizontalAlignment="Stretch"
                    Background="#0082c9" Foreground="White"
                    Click="UploadButton_Click" />

            <ProgressRing x:Name="UploadRing" IsActive="False"
                          HorizontalAlignment="Center" />
            <TextBlock x:Name="StatusText" FontSize="13" Foreground="#757575"
                       TextWrapping="Wrap" Visibility="Collapsed" />

            <Button x:Name="CancelButton" Content="Cancel"
                    HorizontalAlignment="Stretch"
                    Background="Transparent" Foreground="#757575"
                    Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Page>
