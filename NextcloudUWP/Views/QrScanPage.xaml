<Page x:Class="NextcloudUWP.Views.QrScanPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Black">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#0082c9" Padding="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Click="BackButton_Click"
                    Foreground="White" Background="Transparent">
                <SymbolIcon Symbol="Back" />
            </Button>
            <TextBlock Grid.Column="1" Text="Scan QR Code"
                       Foreground="White" VerticalAlignment="Center"
                       FontSize="18" Margin="8,0,0,0" />
        </Grid>

        <!-- Camera preview -->
        <CaptureElement x:Name="CameraPreview"
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Stretch="UniformToFill" />

        <!-- Viewfinder overlay -->
        <Border Grid.Row="1"
                Width="220" Height="220"
                BorderBrush="White" BorderThickness="2"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                IsHitTestVisible="False" />

        <!-- Status -->
        <TextBlock x:Name="StatusText"
                   Grid.Row="1"
                   Text="Point at a Nextcloud login QR code"
                   Foreground="White" FontSize="14"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                   Margin="16,0,16,24"
                   TextWrapping="Wrap" TextAlignment="Center" />

        <ProgressRing x:Name="ScanRing"
                      Grid.Row="1"
                      IsActive="True" Width="48" Height="48"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Foreground="White" Visibility="Collapsed" />
    </Grid>
</Page>
