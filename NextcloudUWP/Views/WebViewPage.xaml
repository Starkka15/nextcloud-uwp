<Page x:Class="NextcloudUWP.Views.WebViewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Black">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Background="#0082c9" Padding="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Click="BackButton_Click"
                    Foreground="White" Background="Transparent">
                <SymbolIcon Symbol="Back" />
            </Button>
            <TextBlock x:Name="TitleText" Grid.Column="1"
                       Foreground="White" VerticalAlignment="Center"
                       FontSize="16" Margin="8,0,0,0"
                       TextTrimming="CharacterEllipsis" />
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="1">
            <WebView x:Name="ContentWebView"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch" />

            <ProgressRing x:Name="LoadingRing"
                          IsActive="True" Width="60" Height="60"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Foreground="White" />

            <TextBlock x:Name="ErrorText"
                       Foreground="#aaaaaa" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" Padding="16"
                       Visibility="Collapsed" />
        </Grid>
    </Grid>
</Page>
